{
  "name": "@mobolulu/design-system-mobile",
  "version": "0.5.0",
  "description": "MOBOLULU mobile design system — React Native theme + components for the Expo apps.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "module": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./theme.css": "./dist/theme.css",
    "./haptics": "./dist/lib/haptics.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && cp src/theme.css dist/theme.css",
    "test": "jest",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "peerDependencies": {
    "expo-haptics": ">=12.8.0",
    "nativewind": "^4.1.23",
    "react": ">=18",
    "react-native": ">=0.72",
    "react-native-reanimated": ">=3.6.0",
    "react-native-safe-area-context": ">=4.8.0",
    "react-native-svg": ">=14.1.0"
  },
  "peerDependenciesMeta": {
    "expo-haptics": {
      "optional": true
    }
  },
  "devDependencies": {
    "@react-native/babel-preset": "^0.74.89",
    "@testing-library/react-native": "^12.9.0",
    "@types/jest": "^29.5.14",
    "@types/react": "^18.3.0",
    "expo-haptics": "^13.0.1",
    "jest": "^29.7.0",
    "nativewind": "^4.1.23",
    "react": "18.2.0",
    "react-native": "^0.74.0",
    "react-native-reanimated": "~3.10.1",
    "react-native-safe-area-context": "^4.10.5",
    "react-native-svg": "^14.1.0",
    "react-test-renderer": "^18.2.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.6.0"
  }
