{
  "expo": {
    "owner": "airwaste",
    "name": "MOBOLULU Design System (Mobile)",
    "slug": "airwaste-design-system-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "mobolulu-ds",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "backgroundColor": "#15803D",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "id.mobolulu.designsystem.mobile"
    },
    "android": {
      "package": "id.mobolulu.designsystem.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#15803D"
      }
    },
    "web": {
      "bundler": "metro"
    }
  }
}
